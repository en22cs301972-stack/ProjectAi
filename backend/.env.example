# Application
APP_NAME="AI Learning Platform"
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql+asyncpg://aiuser:aipassword@postgres:5432/aiplatform
DATABASE_URL_SYNC=postgresql://aiuser:aipassword@postgres:5432/aiplatform

# Redis
REDIS_URL=redis://redis:6379

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Encryption (must be 32 bytes for Fernet)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
