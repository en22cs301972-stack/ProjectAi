# Application
SECRET_KEY=change-this-super-secret-key-in-production-please
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=aipassword
